# Copy this file to backend/.env and replace the placeholder values.
# Never commit the real .env file.

APP_NAME=Organic Farming Guide
DATABASE_URL=sqlite:///./data/organic_farming.db
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Created on first startup when these are set. Registration cannot create administrators.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Farm Administrator

# groq, gemini, or grok. Leave the key empty until you have one.
# The chatbot will not invent an AI answer when the key is missing.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Vision-capable Groq model used only by the photo guide.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROK_API_KEY=
GROK_MODEL=grok-4.7

# Low-memory mode supports indexing on small instances, with weaker semantic retrieval.
EMBEDDING_BACKEND=deterministic
# Install requirements-ml.txt and set this backend for full semantic embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIR=./data/vector_store
KNOWLEDGE_DIR=./knowledge_base
AUTO_INDEX=true
RELEVANCE_THRESHOLD=0.28
RETRIEVAL_K=4
# PDF and DOCX uploads require the optional requirements-documents.txt dependencies.
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
